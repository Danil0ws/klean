#!/usr/bin/env bash
# Called by asdf/mise with ASDF_INSTALL_TYPE, ASDF_INSTALL_VERSION and
# ASDF_INSTALL_PATH set. Downloads the release tarball for this platform and
# installs the binary into $ASDF_INSTALL_PATH/bin.
set -euo pipefail

REPO="${KLEAN_REPO:-danil0ws/klean}"
version="${ASDF_INSTALL_VERSION:-latest}"
install_dir="${ASDF_INSTALL_PATH:?ASDF_INSTALL_PATH is required}"

if [ "$version" = "latest" ]; then
  version="$("$(dirname "$0")/latest-version")"
fi

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)  target="aarch64-apple-darwin" ;;
  Darwin-*)      target="x86_64-apple-darwin" ;;
  Linux-aarch64) target="aarch64-unknown-linux-musl" ;;
  Linux-*)       target="x86_64-unknown-linux-musl" ;;
  *)
    echo "unsupported platform: $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

url="https://github.com/${REPO}/releases/download/v${version}/klean-v${version}-${target}.tar.gz"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$install_dir/bin"
curl -fsSL -o "$tmp/klean.tar.gz" "$url"
tar xzf "$tmp/klean.tar.gz" -C "$tmp"
install -m 0755 "$tmp/klean" "$install_dir/bin/klean"
